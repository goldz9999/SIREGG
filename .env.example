# Copia como .env (en la raíz de este repo, junto a docker-compose.yml) y complétalo.
# El .env nunca se sube a Git.

# Dominio público (Nginx del host lo reenvía a los puertos de abajo).
DOMINIO=sisreg.sublitex.pe

# Puertos locales (solo 127.0.0.1). Deben estar libres: ss -ltnp | grep -E ':3100|:3101'
BACKEND_PORT=3100
FRONTEND_PORT=3101

# --- Supabase (proyecto SIREGG) ---
SUPABASE_URL=https://bqcfsgdlhzjstzbfbner.supabase.co
# service_role key: Supabase -> Project Settings -> API Keys. Nunca la anon key.
SUPABASE_KEY=

# --- Auth --- genera con: openssl rand -hex 48
JWT_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Texto aleatorio largo (openssl rand -hex 24). Se usa al conectar el bot.
TELEGRAM_WEBHOOK_SECRET=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
